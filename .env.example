# Telegram progress notifications (used by cli/run_trials.py).
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.
#
# Note: values in `.env` override variables already present in the process
# environment, so this file is the single source of truth for the runner.
#
# Discover your chat ID with:
#   python -m cli.telegram_notify chat-id
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789
