<?xml version="1.0"?>
<!--
  LIMITATION 1 - MakeInconsistent does not terminate (no progress, no result).

  A consistent ontology with a single axiom:  owl:Thing \sqsubseteq A  where A is
  a leaf class.

  Strengthening a subsumption C \sqsubseteq D means generalising C and/or
  specialising D:
    - owl:Thing has no proper superclass, so the left side cannot be generalised;
    - A has no proper subclass in the signature, so the only right-hand
      candidate is owl:Nothing, giving  owl:Thing \sqsubseteq owl:Nothing,
      which MakeInconsistent discards because it is inconsistent on its own
      ("too strong" filter: it is checked in an empty ontology).

  The candidate set is therefore empty, nothing is ever added, the ontology
  never becomes inconsistent, and the loop

      while (isConsistent || iter < minIter || iterSinceInconsistency < minAfter)

  has no iteration cap and no no-progress check (minIter = minAfter = 0).  The
  process spins forever with an unchanged axiom set.

  Expected: killed by the external timeout, ZERO lines of "adding axiom", and no
  "=== BEGIN RESULT ===" marker in the output.
-->
<rdf:RDF xmlns="http://example.org/limitations/fixedpoint#"
     xml:base="http://example.org/limitations/fixedpoint"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://example.org/limitations/fixedpoint"/>

    <owl:Class rdf:about="http://example.org/limitations/fixedpoint#A"/>

    <!-- owl:Thing \sqsubseteq A -->
    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#Thing">
        <rdfs:subClassOf rdf:resource="http://example.org/limitations/fixedpoint#A"/>
    </owl:Class>

</rdf:RDF>
